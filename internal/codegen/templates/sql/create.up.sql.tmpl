BEGIN;

CREATE TABLE {{ .Relation }} (
{{- $constraintCount := len .Migration.TableConstraints }}
{{- range $i, $field := .Fields }}
	{{ $field.SQLLine }}{{ if or (lt $i (sub (len $.Fields) 1)) (gt $constraintCount 0) }},{{ end }}
{{- end }}
{{- range $i, $constraint := .Migration.TableConstraints }}
	{{ $constraint }}{{ if lt $i (sub $constraintCount 1) }},{{ end }}
{{- end }}
);
{{- if .TableComment }}

COMMENT ON TABLE {{ .Relation }} IS {{ sqlQuote .TableComment }};
{{- end }}
{{- range .Fields }}
{{- if .Comment }}
COMMENT ON COLUMN {{ $.Relation }}.{{ .Name }} IS {{ sqlQuote .Comment }};
{{- end }}
{{- end }}
{{- range .Migration.Indexes }}

CREATE {{ if .Unique }}UNIQUE {{ end }}INDEX {{ .Name }}
	ON {{ $.Relation }} USING {{ .Method }} ({{ .ColumnsSQL }}){{ if .Where }}
	WHERE {{ .Where }}{{ end }};
{{- end }}
{{- if .Migration.HasUpdatedAtTrigger }}

CREATE FUNCTION {{ .TableSchema }}.{{ .Migration.UpdatedAtFunction }}()
RETURNS trigger
LANGUAGE plpgsql
AS $$
BEGIN
	NEW.{{ .Migration.UpdatedAtTrigger }} = now();
	RETURN NEW;
END;
$$;

CREATE TRIGGER {{ .TableName }}_set_updated_at_trigger
BEFORE UPDATE ON {{ .Relation }}
FOR EACH ROW
EXECUTE FUNCTION {{ .TableSchema }}.{{ .Migration.UpdatedAtFunction }}();
{{- end }}
{{- if .PermissionRows }}

WITH required(code, description) AS (
	VALUES
{{- range $i, $permission := .PermissionRows }}
		({{ sqlQuote $permission.Code }}, {{ sqlQuote $permission.Description }}){{ if lt $i (sub (len $.PermissionRows) 1) }},{{ end }}
{{- end }}
)
INSERT INTO public.permissions (code, description)
SELECT required.code, required.description
FROM required
ON CONFLICT (code) DO UPDATE
SET description = EXCLUDED.description;
{{- if .GrantRoles }}

WITH roles(role_id) AS (
	VALUES
{{- range $i, $role := .GrantRoles }}
		({{ sqlQuote $role }}::public.role_types){{ if lt $i (sub (len $.GrantRoles) 1) }},{{ end }}
{{- end }}
), required(permission_code) AS (
	VALUES
{{- range $i, $permission := .PermissionRows }}
		({{ sqlQuote $permission.Code }}){{ if lt $i (sub (len $.PermissionRows) 1) }},{{ end }}
{{- end }}
)
INSERT INTO public.role_permissions (role_id, permission_code)
SELECT roles.role_id, required.permission_code
FROM roles
CROSS JOIN required
ON CONFLICT DO NOTHING;
{{- end }}
{{- end }}
{{- if .ApplicationRoute.Enabled }}

INSERT INTO public.application_routes (
	name,
	path,
	descr,
	section,
	icon,
	menu_available,
	is_active
)
VALUES (
	{{ sqlQuote .ApplicationRoute.Name }},
	{{ sqlQuote .ApplicationRoute.Path }},
	{{ sqlQuote .ApplicationRoute.Description }},
	{{ sqlQuote .ApplicationRoute.Section }},
	{{ sqlNullableText .ApplicationRoute.Icon }},
	{{ .ApplicationRoute.MenuAvailable }},
	true
)
ON CONFLICT (name) DO UPDATE
SET
	path = EXCLUDED.path,
	descr = EXCLUDED.descr,
	section = EXCLUDED.descr,
	icon = EXCLUDED.icon,
	menu_available = EXCLUDED.menu_available,
	is_active = true;
{{- end }}
{{- if .Menu.Enabled }}
{{- if and .Menu.HasParent .Menu.CreateParent }}

INSERT INTO public.main_menus (
	role_id,
	caption,
	icon,
	sort_order,
	is_active
)
SELECT
	{{ sqlQuote .Menu.Role }}::public.role_types,
	{{ sqlQuote .Menu.ParentCaption }},
	{{ sqlNullableText .Menu.ParentIcon }},
	{{ .Menu.ParentSortOrder }},
	true
WHERE NOT EXISTS (
	SELECT 1
	FROM public.main_menus AS existing
	WHERE existing.role_id = {{ sqlQuote .Menu.Role }}::public.role_types
		AND existing.user_id IS NULL
		AND existing.parent_id IS NULL
		AND existing.caption = {{ sqlQuote .Menu.ParentCaption }}
);

UPDATE public.main_menus
SET
	icon = {{ sqlNullableText .Menu.ParentIcon }},
	sort_order = {{ .Menu.ParentSortOrder }},
	is_active = true
WHERE role_id = {{ sqlQuote .Menu.Role }}::public.role_types
	AND user_id IS NULL
	AND parent_id IS NULL
	AND caption = {{ sqlQuote .Menu.ParentCaption }};
{{- end }}

UPDATE public.main_menus AS existing
SET
{{- if .Menu.HasParent }}
	parent_id = (
		SELECT parent.id
		FROM public.main_menus AS parent
		WHERE parent.role_id = {{ sqlQuote .Menu.Role }}::public.role_types
			AND parent.user_id IS NULL
			AND parent.parent_id IS NULL
			AND parent.caption = {{ sqlQuote .Menu.ParentCaption }}
		ORDER BY parent.id
		LIMIT 1
	),
{{- else }}
	parent_id = NULL,
{{- end }}
	caption = {{ sqlQuote .Menu.Caption }},
	icon = {{ sqlNullableText .Menu.Icon }},
	sort_order = {{ .Menu.SortOrder }},
	is_active = {{ .Menu.IsActive }}
FROM public.application_routes AS route
WHERE route.name = {{ sqlQuote .ApplicationRoute.Name }}
	AND existing.role_id = {{ sqlQuote .Menu.Role }}::public.role_types
	AND existing.user_id IS NULL
	AND existing.route_id = route.id
{{- if .Menu.HasParent }}
	AND EXISTS (
		SELECT 1
		FROM public.main_menus AS parent
		WHERE parent.role_id = {{ sqlQuote .Menu.Role }}::public.role_types
			AND parent.user_id IS NULL
			AND parent.parent_id IS NULL
			AND parent.caption = {{ sqlQuote .Menu.ParentCaption }}
	)
{{- end }}
;

INSERT INTO public.main_menus (
	role_id,
	parent_id,
	caption,
	route_id,
	icon,
	sort_order,
	is_active
)
SELECT
	{{ sqlQuote .Menu.Role }}::public.role_types,
{{- if .Menu.HasParent }}
	parent.id,
{{- else }}
	NULL,
{{- end }}
	{{ sqlQuote .Menu.Caption }},
	route.id,
	{{ sqlNullableText .Menu.Icon }},
	{{ .Menu.SortOrder }},
	{{ .Menu.IsActive }}
FROM public.application_routes AS route
{{- if .Menu.HasParent }}
JOIN LATERAL (
	SELECT item.id
	FROM public.main_menus AS item
	WHERE item.role_id = {{ sqlQuote .Menu.Role }}::public.role_types
		AND item.user_id IS NULL
		AND item.parent_id IS NULL
		AND item.caption = {{ sqlQuote .Menu.ParentCaption }}
	ORDER BY item.id
	LIMIT 1
) AS parent ON true
{{- end }}
WHERE route.name = {{ sqlQuote .ApplicationRoute.Name }}
	AND NOT EXISTS (
		SELECT 1
		FROM public.main_menus AS existing
		WHERE existing.role_id = {{ sqlQuote .Menu.Role }}::public.role_types
			AND existing.user_id IS NULL
			AND existing.route_id = route.id
	);
{{- end }}

COMMIT;
