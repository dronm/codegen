-- Code generated by cmd/codegen. Review before applying.

BEGIN;
{{- if .Menu.Enabled }}

DELETE FROM public.main_menus AS menu
USING public.application_routes AS route
WHERE menu.route_id = route.id
	AND menu.role_id = {{ sqlQuote .Menu.Role }}
	AND menu.user_id IS NULL
	AND menu.caption = {{ sqlQuote .Menu.Caption }}
	AND route.name = {{ sqlQuote .ApplicationRoute.Name }};
{{- if and .Menu.HasParent .Menu.CreateParent }}

DELETE FROM public.main_menus AS parent
WHERE parent.role_id = {{ sqlQuote .Menu.Role }}
	AND parent.user_id IS NULL
	AND parent.parent_id IS NULL
	AND parent.caption = {{ sqlQuote .Menu.ParentCaption }}
	AND NOT EXISTS (
		SELECT 1
		FROM public.main_menus AS child
		WHERE child.parent_id = parent.id
	);
{{- end }}
{{- end }}
{{- if .ApplicationRoute.Enabled }}

DELETE FROM public.application_routes AS route
WHERE route.name = {{ sqlQuote .ApplicationRoute.Name }}
	AND NOT EXISTS (
		SELECT 1
		FROM public.main_menus AS menu
		WHERE menu.route_id = route.id
	);
{{- end }}
{{- if .PermissionRows }}

DELETE FROM public.role_permissions
WHERE permission_code IN (
{{- range $i, $permission := .PermissionRows }}
	{{ sqlQuote $permission.Code }}{{ if lt $i (sub (len $.PermissionRows) 1) }},{{ end }}
{{- end }}
);

DELETE FROM public.permissions
WHERE code IN (
{{- range $i, $permission := .PermissionRows }}
	{{ sqlQuote $permission.Code }}{{ if lt $i (sub (len $.PermissionRows) 1) }},{{ end }}
{{- end }}
);
{{- end }}

DROP TABLE IF EXISTS {{ .Relation }};
{{- if .Migration.HasUpdatedAtTrigger }}
DROP FUNCTION IF EXISTS {{ .TableSchema }}.{{ .Migration.UpdatedAtFunction }}();
{{- end }}

COMMIT;
