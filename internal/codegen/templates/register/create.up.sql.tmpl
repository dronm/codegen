{{- range $index, $dimension := .Dimensions }}
	in_{{ $dimension.FilterName }} {{ $dimension.ArraySQLType }} DEFAULT NULL{{ if lt $index (sub (len $.Dimensions) 1) }},{{ end }}
{{- end }}
)
RETURNS TABLE (
{{- range .Dimensions }}
	{{ .Name }} {{ .SQLType }},
{{- end }}
{{- range $index, $resource := .Resources }}
	{{ $resource.Name }}_opening {{ $resource.SQLType }},
	{{ $resource.Name }}_increase {{ $resource.SQLType }},
	{{ $resource.Name }}_decrease {{ $resource.SQLType }},
	{{ $resource.Name }}_closing {{ $resource.SQLType }}{{ if lt $index (sub (len $.Resources) 1) }},{{ end }}
{{- end }}
)
LANGUAGE sql
STABLE
AS $function$
	WITH opening AS (
		SELECT *
		FROM {{ .Schema }}.rg_{{ .Snake }}_balance(
			in_from,
{{- range $index, $dimension := .Dimensions }}
			in_{{ $dimension.FilterName }}{{ if lt $index (sub (len $.Dimensions) 1) }},{{ end }}
{{- end }}
		)
	), turnover AS (
		SELECT
{{- range .Dimensions }}
			action.{{ .Name }},
{{- end }}
{{- range $index, $resource := .Resources }}
			COALESCE(SUM(action.{{ $resource.Name }}) FILTER (WHERE action.{{ $resource.Name }} > 0), 0)::{{ $resource.SQLType }} AS {{ $resource.Name }}_increase,
			COALESCE(-SUM(action.{{ $resource.Name }}) FILTER (WHERE action.{{ $resource.Name }} < 0), 0)::{{ $resource.SQLType }} AS {{ $resource.Name }}_decrease,
			COALESCE(SUM(action.{{ $resource.Name }}), 0)::{{ $resource.SQLType }} AS {{ $resource.Name }}_net{{ if lt $index (sub (len $.Resources) 1) }},{{ end }}
{{- end }}
		FROM {{ .ActionRelation }} AS action
		WHERE action.effective_at >= in_from
			AND action.effective_at < in_to
{{- range .Dimensions }}
			AND (
				in_{{ .FilterName }} IS NULL
				OR cardinality(in_{{ .FilterName }}) = 0
				OR action.{{ .Name }} = ANY(in_{{ .FilterName }})
			)
{{- end }}
		GROUP BY
{{- range $index, $dimension := .Dimensions }}
			action.{{ $dimension.Name }}{{ if lt $index (sub (len $.Dimensions) 1) }},{{ end }}
{{- end }}
	), keys AS (
		SELECT
{{- range $index, $dimension := .Dimensions }}
			opening.{{ $dimension.Name }}{{ if lt $index (sub (len $.Dimensions) 1) }},{{ end }}
{{- end }}
		FROM opening

		UNION

		SELECT
{{- range $index, $dimension := .Dimensions }}
			turnover.{{ $dimension.Name }}{{ if lt $index (sub (len $.Dimensions) 1) }},{{ end }}
{{- end }}
		FROM turnover
	)
