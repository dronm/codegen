STABLE
AS $function$
	WITH boundary AS (
		SELECT
			{{ .RuntimeSchema }}.register_month_start(in_effective_at) AS period_start,
			{{ .RuntimeSchema }}.register_month_start_at(in_effective_at) AS period_start_at
	), movements AS (
		SELECT
{{- range .Dimensions }}
			period.{{ .Name }},
{{- end }}
{{- range $index, $resource := .Resources }}
			period.{{ $resource.Name }}{{ if lt $index (sub (len $.Resources) 1) }},{{ end }}
{{- end }}
		FROM {{ .PeriodRelation }} AS period
		CROSS JOIN boundary
		WHERE period.period_start < boundary.period_start
{{- range .Dimensions }}
			AND (
				in_{{ .FilterName }} IS NULL
				OR cardinality(in_{{ .FilterName }}) = 0
				OR period.{{ .Name }} = ANY(in_{{ .FilterName }})
			)
{{- end }}

		UNION ALL

		SELECT
{{- range .Dimensions }}
			action.{{ .Name }},
{{- end }}
{{- range $index, $resource := .Resources }}
			action.{{ $resource.Name }}{{ if lt $index (sub (len $.Resources) 1) }},{{ end }}
{{- end }}
		FROM {{ .ActionRelation }} AS action
		CROSS JOIN boundary
		WHERE action.effective_at >= boundary.period_start_at
			AND action.effective_at < in_effective_at
{{- range .Dimensions }}
			AND (
				in_{{ .FilterName }} IS NULL
				OR cardinality(in_{{ .FilterName }}) = 0
				OR action.{{ .Name }} = ANY(in_{{ .FilterName }})
			)
{{- end }}
	)
	SELECT
{{- range .Dimensions }}
		movements.{{ .Name }},
{{- end }}
{{- range $index, $resource := .Resources }}
		SUM(movements.{{ $resource.Name }})::{{ $resource.SQLType }} AS {{ $resource.Name }}{{ if lt $index (sub (len $.Resources) 1) }},{{ end }}
{{- end }}
	FROM movements
	GROUP BY
{{- range $index, $dimension := .Dimensions }}
		movements.{{ $dimension.Name }}{{ if lt $index (sub (len $.Dimensions) 1) }},{{ end }}
{{- end }}
	HAVING
{{- range $index, $resource := .Resources }}
		{{ if $index }}OR {{ end }}SUM(movements.{{ $resource.Name }}) <> 0
{{- end }}
	ORDER BY
{{- range $index, $dimension := .Dimensions }}
		movements.{{ $dimension.Name }}{{ if lt $index (sub (len $.Dimensions) 1) }},{{ end }}
{{- end }}
	;
