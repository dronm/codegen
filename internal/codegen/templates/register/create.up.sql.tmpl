{{- range .Dimensions }}
		keys.{{ .Name }},
{{- end }}
{{- range $index, $resource := .Resources }}
		COALESCE(opening.{{ $resource.Name }}, 0)::{{ $resource.SQLType }} AS {{ $resource.Name }}_opening,
		COALESCE(turnover.{{ $resource.Name }}_increase, 0)::{{ $resource.SQLType }} AS {{ $resource.Name }}_increase,
		COALESCE(turnover.{{ $resource.Name }}_decrease, 0)::{{ $resource.SQLType }} AS {{ $resource.Name }}_decrease,
		(COALESCE(opening.{{ $resource.Name }}, 0) + COALESCE(turnover.{{ $resource.Name }}_net, 0))::{{ $resource.SQLType }} AS {{ $resource.Name }}_closing{{ if lt $index (sub (len $.Resources) 1) }},{{ end }}
