CREATE OR REPLACE FUNCTION {{ .Schema }}.rg_{{ .Snake }}_balance(
	in_effective_at timestamptz,
{{- range $index, $dimension := .Dimensions }}
	in_{{ $dimension.FilterName }} {{ $dimension.ArraySQLType }} DEFAULT NULL{{ if lt $index (sub (len $.Dimensions) 1) }},{{ end }}
